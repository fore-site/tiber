# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tiber
# Sync URL for Alembic migrations (psycopg2 driver)
DATABASE_SYNC_URL=postgresql+psycopg2://user:password@localhost:5432/tiber

# RabbitMQ
RABBITMQ_URL=amqp://user:password@localhost:5672/
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Redis
# DB 0: JWT blocklist, API key revocation, rate limiting, idempotency keys
REDIS_URL=redis://localhost:6379/0

# Auth
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_SENDER=notifications@example.com
DASHBOARD_URL=http://localhost:3000
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/v1/auth/github/callback

# Rate Limiting
RATE_LIMIT_AUTH_REQUESTS=20
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_DASHBOARD_REQUESTS=100
RATE_LIMIT_DASHBOARD_WINDOW_SECONDS=60
RATE_LIMIT_API_REQUESTS=100
RATE_LIMIT_API_WINDOW_SECONDS=60

# Idempotency
IDEMPOTENCY_TTL_SECONDS=86400

# Object Storage 
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_MODELS=tiber-models
STORAGE_BUCKET_DATASETS=tiber-datasets
STORAGE_SECURE=false

# Observability
# Leave empty to disable OTLP export
OTLP_ENDPOINT=http://localhost:4318

# AI Providers
GROQ_API_KEY=
GEMINI_API_KEY=

# Email Provider
# Options: resend | sendgrid | mock
EMAIL_PROVIDER=mock
RESEND_API_KEY=re_placeholder_replace_me
SENDGRID_API_KEY=SG.placeholder_replace_me

# Push Provider
# Options: fcm | mock
PUSH_PROVIDER=mock
FCM_PROJECT_ID=replace-with-firebase-project-id
FCM_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n
FCM_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com

# SMS Provider
# Options: twilio | mock
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_FROM_NUMBER=+15005550006

# Transactional outbox relay
OUTBOX_RELAY_INTERVAL_SECONDS=1
OUTBOX_RELAY_BATCH_SIZE=100
OUTBOX_RETRY_MAX_ATTEMPTS=10
OUTBOX_RETRY_BASE_DELAY_SECONDS=1
OUTBOX_RETRY_MAX_DELAY_SECONDS=300
NOTIFICATION_PROCESSING_LEASE_SECONDS=300
